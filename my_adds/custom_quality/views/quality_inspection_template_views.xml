<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- INSPECTION FORM -->
    <!-- ===================================================== -->

    <record id="view_quality_inspection_template_form"
            model="ir.ui.view">

        <field name="name">quality.inspection.template.form</field>

        <field name="model">quality.inspection.template</field>

        <field name="arch" type="xml">

            <form string="Inspection Form">

                <sheet>

                    <group>

                        <field name="name"/>

                        <field name="product_category_id"/>

                    </group>

                    <notebook>

                        <page string="Inspection Fields">

                            <field name="inspection_field_ids">

                                <tree editable="bottom">

                                    <field name="sequence"/>

                                    <field name="name"/>

                                    <field name="test_type_id" options="{'no_open': True, 'no_create': True}"/>

                                    <field name="required"/>

                                    <field name="help_text"/>

                                </tree>

                                <form string="Inspection Field">

                                    <sheet>

                                        <group>

                                            <field name="name"/>

                                            <field name="test_type_id" options="{'no_open': True, 'no_create': True}"/>

                                            <field name="required"/>

                                            <field name="sequence"/>

                                            <field name="help_text"/>

                                        </group>

                                    </sheet>

                                </form>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ===================================================== -->
    <!-- INSPECTION FORM TREE -->
    <!-- ===================================================== -->

    <record id="view_quality_inspection_template_tree"
            model="ir.ui.view">

        <field name="name">quality.inspection.template.tree</field>

        <field name="model">quality.inspection.template</field>

        <field name="arch" type="xml">

            <tree string="Inspection Forms">

                <field name="name"/>

                <field name="product_category_id"/>

            </tree>

        </field>

    </record>


    <!-- ===================================================== -->
    <!-- ACTION -->
    <!-- ===================================================== -->

    <record id="action_quality_inspection_template"
            model="ir.actions.act_window">

        <field name="name">Inspection Forms</field>

        <field name="res_model">quality.inspection.template</field>

        <field name="view_mode">tree,form</field>

    </record>


    <!-- ===================================================== -->
    <!-- MENU -->
    <!-- ===================================================== -->

    <menuitem
        id="menu_quality_inspection_template"
        name="Inspection Forms"
        parent="quality_control.menu_quality_configuration"
        action="action_quality_inspection_template"
        sequence="50"/>

</odoo>