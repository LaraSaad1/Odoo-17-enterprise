<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_custom_quality_inspection_form"
            model="ir.ui.view">

        <field name="name">custom.quality.inspection.form</field>

        <field name="model">custom.quality.inspection</field>

        <field name="arch" type="xml">

            <form string="Quality Inspection">

                <header>

                    <button
                        name="action_pass"
                        string="Pass"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"/>

                    <button
                        name="action_fail"
                        string="Fail"
                        type="object"
                        class="btn-danger"
                        invisible="state != 'draft'"/>

                    <field name="state"
                           widget="statusbar"/>

                </header>

                <sheet>

                    <group>

                        <group>

                            <field name="name"/>

                            <field name="product_id"/>

                        </group>

                        <group>

                            <field name="quality_check_id"/>

                            <field name="quality_point_id"/>

                        </group>

                    </group>


                    <notebook>

                        <page string="Inspection Results">

                            <field name="inspection_line_ids">

                                <tree editable="bottom">

                                    <field name="sequence"
                                           column_invisible="True"/>

                                    <field name="name"/>

                                    <field name="test_type_id" options="{'no_open': True, 'no_create': True}"/>

                                    <field name="value"/>

                                    <field name="required"/>

                                </tree>

                                <form string="Inspection Result">

                                    <sheet>

                                        <group>

                                            <field name="name"
                                                   readonly="1"/>

                                            <field name="test_type_id"
                                                   readonly="1"/>

                                            <field name="required"
                                                   readonly="1"/>

                                            <field name="value"/>

                                            <field name="help_text"
                                                   readonly="1"/>

                                        </group>

                                    </sheet>

                                </form>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>

    </record>

</odoo>