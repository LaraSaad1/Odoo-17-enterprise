<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_telesales_call_tree" model="ir.ui.view">
        <field name="name">telesales.call.tree</field>
        <field name="model">telesales.call</field>
        <field name="arch" type="xml">
            <tree decoration-muted="status == 'Cancelled'" decoration-success="status == 'Confirmed'">
                <field name="name"/>
                <field name="call_date"/>
                <field name="day_of_week"/>
                <field name="customer_id"/>
                <field name="phone"/>
                <field name="governorate_id"/>
                <field name="district"/>
                <field name="category"/>
                <field name="product_id"/>
                <field name="employee_id"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'Confirmed'"
                       decoration-danger="status == 'Cancelled'"
                       decoration-info="status == 'Draft'"/>
            </tree>
        </field>
    </record>
    <!-- Form View -->
    <record id="view_telesales_call_form" model="ir.ui.view">
        <field name="name">telesales.call.form</field>
        <field name="model">telesales.call</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="status == 'cancelled'"/>
                    <button name="action_reset_to_draft" type="object" string="Rseset to Draft"
                            invisible="status in ('cancelled', 'draft')"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="بيانات المكالمة">
                            <field name="call_date"/>
                            <field name="day_of_week"/>
                            <field name="employee_id"/>
                        </group>
                        <group string="بيانات العميل">
                            <field name="customer_id"/>
                            <field name="phone"/>
                        </group>
                    </group>
                    <group>
                        <group string="الموقع">
                            <field name="governorate_id"/>
                            <field name="district"/>
                        </group>
                        <group string="التصنيف">
                            <field name="category"/>
                            <field name="product_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="ملاحظات عن العميل..."/>
                        <field name="employee_notes" placeholder="ملاحظات الموظف عن نتيجة المكالمة..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <!-- Kanban View -->
    <record id="view_telesales_call_kanban" model="ir.ui.view">
        <field name="name">telesales.call.kanban</field>
        <field name="model">telesales.call</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="customer_id"/>
                <field name="call_date"/>
                <field name="category"/>
                <field name="status"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <strong>
                                    <field name="customer_id"/>
                                </strong>
                                <div>
                                    <field name="call_date"/>
                                </div>
                                <div>
                                    <field name="governorate_id"/> -
                                    <field name="district"/>
                                </div>
                                <span class="badge badge-pill">
                                    <field name="category"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!-- Search View -->
    <record id="view_telesales_call_search" model="ir.ui.view">
        <field name="name">telesales.call.search</field>
        <field name="model">telesales.call</field>
        <field name="arch" type="xml">
            <search>
                <field name="customer_id"/>
                <field name="phone"/>
                <field name="governorate_id"/>
                <field name="district"/>
                <field name="employee_id"/>
                <field name="product_id"/>
                <filter string="My Calls" name="my_calls" domain="[('employee_id', '=', uid)]"/>
                <filter string="Draft" name="draft" domain="[('status', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('status', '=', 'confirmed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('status', '=', 'cancelled')]"/>
                <separator/>
                <filter string="اليوم" name="today"
                        domain="[('call_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="تجميع حسب">
                    <filter string="الموظف" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="المحافظة" name="group_governorate" context="{'group_by': 'governorate_id'}"/>
                    <filter string="التصنيف" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="الحالة" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="التاريخ" name="group_date" context="{'group_by': 'call_date'}"/>
                </group>
            </search>
        </field>
    </record>
    <!-- Actions -->
    <record id="action_telesales_call" model="ir.actions.act_window">
        <field name="name">Calls</field>
        <field name="res_model">telesales.call</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'search_default_my_calls': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                سجّل أول مكالمة تليسيلز
            </p>
        </field>
    </record>
</odoo>