<odoo>
    <template id="report_quotation_offer_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="company" t-value="res_company"/>
                <!--  Which optional columns actually have data on at least one line  -->
                <t t-set="show_pests" t-value="any(l.product_tmpl_id.pests for l in doc.line_ids)"/>
                <t t-set="show_formulation" t-value="any(l.product_tmpl_id.formulation for l in doc.line_ids)"/>
                <t t-set="show_usage_rate" t-value="any(l.product_tmpl_id.usage_rate for l in doc.line_ids)"/>
                <t t-set="show_unit" t-value="any(l.attribute_value_id for l in doc.line_ids)"/>
                <t t-set="show_price" t-value="any(l.price_unit for l in doc.line_ids)"/>
                <div class="page" dir="rtl" style="font-family: Arial, 'Helvetica Neue', sans-serif; color:#222; font-size:12px;">
                    <!--  ===== Header =====  -->
                    <div style="display:flex; direction:ltr; justify-content:space-between; align-items:flex-start; width:100%; margin-bottom:6px;">
                        <div style="text-align:left;">
                            <img t-if="company.logo"
     t-att-src="image_data_uri(company.logo)"
     style="max-height:120px; max-width:300px; width:auto; height:auto; object-fit:contain; border-radius:0; display:block;"/>
                            <div t-if="not company.logo" style="font-size:24px; font-weight:bold; color:#2aa7a0;">
SPARK
                                <span style="font-weight:300;">CHEMICALS</span>
                            </div>
                        </div>
                        <div style="text-align:right; direction:rtl; font-weight:bold; font-size:18px;">
                            <div>
السـادة:
                                <span t-esc="doc.consignee_name"/>
                            </div>
                            <div>
تحريرا فى:
                                <span t-esc="doc.date_offer" t-options="{'widget': 'date'}"/>
                            </div>
                        </div>
                    </div>
                    <hr style="border-top:1px solid #333;"/>
                    <h3 style="text-align:center; color:#2aa7a0; margin:14px 0; font-size:20px;">عرض سعر</h3>
                    <p style="margin-bottom:2px; font-size:19px;">تحية طيبة وبعد ،،،،</p>
                    <p style="margin-top:0; font-size:19px;"> تتشرف شركة سبارك للكيماويات بتقديم عرض سعر بالأصناف الاتية :- </p>
                    <!--  ===== Items table =====  -->
                    <table class="table" style="width:100%; border-collapse:collapse; margin-top:10px;" dir="rtl">
                        <thead>
                            <tr style="background-color:#2aa7a0; color:#fff;">
                                <th style="border:1px solid #999; padding:4px; text-align:center;">م</th>
                                <th style="border:1px solid #999; padding:4px; text-align:center;">اسم الصنف</th>
                                <th t-if="show_pests" style="border:1px solid #999; padding:4px; text-align:center;">الآفه</th>
                                <th t-if="show_formulation" style="border:1px solid #999; padding:4px; text-align:center;">اسم الماده الفعاله</th>
                                <th t-if="show_usage_rate" style="border:1px solid #999; padding:4px; text-align:center;">معدل الاستخدام</th>
                                <th t-if="show_unit" style="border:1px solid #999; padding:4px; text-align:center;">الوحده</th>
                                <th t-if="show_price" style="border:1px solid #999; padding:4px; text-align:center;">سعر الوحده</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.line_ids" t-as="line">
                                <tr>
                                    <td style="border:1px solid #ccc; padding:4px; text-align:center;">
                                        <t t-esc="line_index + 1"/>
                                    </td>
                                    <td style="border:1px solid #ccc; padding:4px; text-align:center;">
                                        <t t-if="line.product_tmpl_id.name">
                                            <span t-esc="line.product_tmpl_id.name"/>
                                        </t>
                                    </td>
                                    <td t-if="show_pests" style="border:1px solid #ccc; padding:4px; text-align:center;">
                                        <t t-if="line.product_tmpl_id.pests">
                                            <span t-esc="line.product_tmpl_id.pests"/>
                                        </t>
                                    </td>
                                    <td t-if="show_formulation" style="border:1px solid #ccc; padding:4px; text-align:center;">
                                        <t t-if="line.product_tmpl_id.formulation">
                                            <span t-esc="line.product_tmpl_id.formulation"/>
                                        </t>
                                    </td>
                                    <td t-if="show_usage_rate" style="border:1px solid #ccc; padding:4px; text-align:center;">
                                        <t t-if="line.product_tmpl_id.usage_rate">
                                            <span t-esc="line.product_tmpl_id.usage_rate"/>
                                        </t>
                                    </td>
                                    <td t-if="show_unit" style="border:1px solid #ccc; padding:4px; text-align:center;">
                                        <t t-if="line.attribute_value_id">
                                            <span t-esc="line.attribute_value_id.name"/>
                                        </t>
                                    </td>
                                    <td t-if="show_price" style="border:1px solid #ccc; padding:4px; text-align:center;">
                                        <t t-if="line.price_unit">
                                            <span t-esc="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <p style="margin-top:24px; font-size:19px;">وتفضلوا بقبول فائق الاحترام ....</p>
                    <div style="margin-top:60px; font-size:18px;">
                        <p>* الأسعار شاملة كافة الضرائب والدمغات والرسوم وكذلك القيمة المضافة حال خضوعها .</p>
                        <p>* النقل والتوصيل إلى مخازن العميل .</p>
                    </div>
                    <div style="margin-top:20px; font-weight:bold; font-size:17px; direction:rtl; text-align:left; line-height:1.8;">
                        <div style="margin:0;">
        مقدماً لسيادتكم，
    </div>
                        <div style="margin:0;">
        شركة سبارك للكيماويات
    </div>
                    </div>
                    <!--  ===== Footer / company address =====  -->
                    <div style="position:fixed; bottom:0; left:0; right:0; text-align:right; font-size:17px; color:#2aa7a0; direction:ltr;">
                        <div t-esc="company.street"/>
                        <div>
                            <span t-if="company.phone">
Mob. (+2)
                                <t t-esc="company.phone"/>
                            </span>
                        </div>
                        <div t-if="company.email" t-esc="company.email"/>
                        <div t-if="company.website" t-esc="company.website"/>
</div>
                </div>
            </t>
        </t>
    </template>
</odoo>