<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quotation_offer_wizard_form" model="ir.ui.view">
        <field name="name">quotation.offer.wizard.form</field>
        <field name="model">quotation.offer.wizard</field>
        <field name="arch" type="xml">
            <form string="طباعة عرض سعر">
                <group>
                    <group>
                        <field name="consignee_name" placeholder="مرسل إليه"/>
                    </group>
                    <group>
                        <field name="date_offer"/>
                    </group>
                </group>
                <field name="line_ids">
                    <tree editable="bottom" create="false">
                        <field name="product_tmpl_id" invisible="1"/>
                        <field name="product_name" readonly="1"/>
                        <field name="attribute_value_id"/>
                        <field name="price_unit" readonly="1"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_print_report" string="طباعة عرض السعر"
                            type="object" class="btn-primary"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>