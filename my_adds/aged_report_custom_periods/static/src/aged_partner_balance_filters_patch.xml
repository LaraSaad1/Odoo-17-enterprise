<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-inherit="account_reports.AccountReportFiltersCustomizable"
       t-inherit-mode="extension">
        <xpath expr="//div[@id='filter_partner']" position="after">
            <div id="filter_aging_based_on"
                class="dropdown btn-group"
                t-if="controller.options.custom_periods_bounds">
                <button type="button" class="btn btn-secondary dropdown-toggle"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fa fa-file me-1"/>
                    Based on
                    <t t-if="controller.options.aging_based_on === 'base_on_invoice_date'">Invoice Date</t>
                    <t t-else="">Due Date</t>
                </button>
                <div class="dropdown-menu">
                    <a href="#" class="dropdown-item"
                    t-on-click.prevent="() => controller.updateOption('aging_based_on', 'base_on_maturity_date', true)">
                        <i t-attf-class="fa fa-check me-1 #{controller.options.aging_based_on === 'base_on_invoice_date' ? 'invisible' : ''}"/>Due Date
                    </a>
                    <a href="#" class="dropdown-item"
                    t-on-click.prevent="() => controller.updateOption('aging_based_on', 'base_on_invoice_date', true)">
                        <i t-attf-class="fa fa-check me-1 #{controller.options.aging_based_on === 'base_on_invoice_date' ? '' : 'invisible'}"/>Invoice Date
                    </a>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[@id='filter_partner']" position="after">
            <!-- Only shown on aged reports: the option only exists there -->
            <div id="filter_custom_periods"
                 class="dropdown btn-group"
                 t-if="controller.options.custom_periods_bounds">
                <button type="button"
                        class="btn btn-secondary dropdown-toggle"
                        data-bs-toggle="dropdown"
                        data-bs-auto-close="outside"
                        aria-expanded="false">
                    <i class="fa fa-calendar-o me-1"/>
                    <t t-esc="controller.options.custom_periods_days"/> Days
                </button>
                <div class="dropdown-menu p-3" style="min-width: 220px;">
                    <label class="form-label fw-bold small text-muted">Age based on</label>
                    <select class="form-select form-select-sm mb-3"
                            t-on-change="(ev) => controller.updateOption('aging_based_on', ev.target.value, true)">
                        <option value="base_on_maturity_date"
                                t-att-selected="controller.options.aging_based_on !== 'base_on_invoice_date'">Due Date</option>
                        <option value="base_on_invoice_date"
                                t-att-selected="controller.options.aging_based_on === 'base_on_invoice_date'">Invoice Date</option>
                    </select>
                    <label class="form-label fw-bold small text-muted">Days per period</label>
                    <!-- Handler is inline: no JS patch needed -->
                    <input type="number" min="1" step="1"
                           class="form-control form-control-sm"
                           t-att-value="controller.options.custom_periods_days"
                           t-on-change="(ev) => controller.updateOption('custom_periods_days', ev.target.value, true)"
                           placeholder="30"/>
                    <div class="form-text text-muted mt-1" style="font-size: 0.75rem;">
                        30 → 1-30, 31-60, 61-90, ...
                        <br/>
                        90 → 1-90, 91-180, 181-270, ...
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>