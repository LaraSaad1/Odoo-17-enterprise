<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-inherit="account_reports.AccountReportFiltersCustomizable"
       t-inherit-mode="extension">
        <xpath expr="//div[@id='filter_partner']" position="after">
            <!-- Only shown on aged reports: the option only exists there -->
            <div id="filter_custom_periods"
                 class="dropdown btn-group"
                 t-if="controller.options.custom_periods_bounds">
                <button type="button"
                        class="btn btn-secondary dropdown-toggle"
                        data-bs-toggle="dropdown"
                        data-bs-auto-close="outside"
                        aria-expanded="false">
                    <i class="fa fa-calendar-o me-1"/>
                    <t t-esc="controller.options.custom_periods_days"/> Days
                </button>
                <div class="dropdown-menu p-3" style="min-width: 220px;">
                    <label class="form-label fw-bold small text-muted">Days per period</label>
                    <!-- Handler is inline: no JS patch needed -->
                    <input type="number" min="1" step="1"
                           class="form-control form-control-sm"
                           t-att-value="controller.options.custom_periods_days"
                           t-on-change="(ev) => controller.updateOption('custom_periods_days', ev.target.value, true)"
                           placeholder="30"/>
                    <div class="form-text text-muted mt-1" style="font-size: 0.75rem;">
                        30 → 1-30, 31-60, 61-90, ...
                        <br/>
                        90 → 1-90, 91-180, 181-270, ...
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>